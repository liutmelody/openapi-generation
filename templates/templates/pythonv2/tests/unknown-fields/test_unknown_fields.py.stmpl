import asyncio
import json
import warnings
from typing import Annotated, Any, List, Optional

import httpx
import pydantic
import pytest

from openapi import SDK, errors, models, utils
from openapi.types import UNSET, BaseModel, Nullable, UnrecognizedInt, UnrecognizedStr
from .common_helpers import HTTPBIN_URL, record_test


PRESERVE_UNKNOWN_FIELDS = {{if .Global.Config.PreserveUnknownFields}}True{{else}}False{{end}}
MODEL_SERIALIZATION_METHODS = {{if .Global.Config.ModelSerializationMethods}}True{{else}}False{{end}}


CASES = [
    ({"futureKind": "third", "futureCode": 3}, {"futureKind": "third", "futureCode": 3}),
    ({"methodNames": {"toDict": "dictionary", "toJson": "json"}}, {"methodNames": {"toDict": "dictionary", "toJson": "json"}}),
    ({"future": "value"}, {}),
    ({"future": False}, {}),
    ({"empty": {"future": True}}, {"empty": {}}),
    ({"future": None}, {}),
    ({"plainChoice": {"text": "value", "future": True}}, {"plainChoice": {"text": "value"}}),
    ({"plainChoice": {"number": 3, "future": True}}, {"plainChoice": {"number": 3}}),
    ({"requiredOnly": {"label": "required", "future": True}}, {"requiredOnly": {"label": "required"}}),
    ({"future": 0}, {}),
    ({"composed": {"displayName": "child", "category": "combined", "future": True}}, {"composed": {"displayName": "child", "category": "combined"}}),
    ({"split": {"label": "split", "future": True}}, {"split": {"label": "split"}}),
    ({"future": []}, {}),
    ({"future": {"nested": [None, False, 0, "value"]}}, {}),
    ({"child": {"displayName": "child", "future": True}}, {"child": {"displayName": "child"}}),
    ({"child": {"displayName": "child", "display_name": "unknown"}}, {"child": {"displayName": "child"}}),
    ({"child": {"displayName": "child", "child": {"displayName": "grandchild", "future": True}}}, {"child": {"displayName": "child", "child": {"displayName": "grandchild"}}}),
    ({"children": [{"displayName": "child", "future": True}]}, {"children": [{"displayName": "child"}]}),
    ({"lookup": {"one": {"displayName": "child", "future": True}}}, {"lookup": {"one": {"displayName": "child"}}}),
    ({"choice": {"kind": "text", "text": "value", "future": True}}, {"choice": {"kind": "text", "text": "value"}}),
    ({"choice": {"kind": "number", "number": 3, "future": True}}, {"choice": {"kind": "number", "number": 3}}),
    ({"closed": {"label": "closed", "future": True}}, {"closed": {"label": "closed"}}),
    ({"open": {"label": "open", "future": True}}, {"open": {"label": "open", "future": True}}),
    ({"typed": {"label": "typed", "future": "value"}}, {"typed": {"label": "typed", "future": "value"}}),
    ({"arbitrary": {"future": {"nullable": None}}}, {"arbitrary": {"future": {"nullable": None}}}),
    ({"child": {"displayName": "child", "nullable": None}}, {"child": {"displayName": "child", "nullable": None}}),
]


@pytest.mark.parametrize("fields, default_fields", CASES)
@pytest.mark.parametrize("as_model", [False, True])
@pytest.mark.parametrize("as_async", [False, True])
def test_unknown_fields_echo(fields, default_fields, as_model, as_async):
    record_test("unknown-fields-json-round-trip")
    payload = {"label": "root", **fields}
    request = models.FieldEnvelopeInput.model_validate(payload) if as_model else payload
    if as_async:
        async def send():
            async with SDK(server_url=HTTPBIN_URL) as sdk:
                return await sdk.echo_unknown_fields_async(request=request)
        response = asyncio.run(send())
    else:
        with SDK(server_url=HTTPBIN_URL) as sdk:
            response = sdk.echo_unknown_fields(request=request)
    expected = {"label": "root", **(fields if PRESERVE_UNKNOWN_FIELDS else default_fields)}
    assert response.http_meta.response.json()["json"] == expected
    assert response.object.json_.model_dump(mode="json", by_alias=True, exclude_none=not PRESERVE_UNKNOWN_FIELDS) == expected
    assert json.loads(response.object.json_.model_dump_json(by_alias=True, exclude_none=not PRESERVE_UNKNOWN_FIELDS)) == expected
    assert ("headers" in response.object.model_dump()) is PRESERVE_UNKNOWN_FIELDS
    if MODEL_SERIALIZATION_METHODS:
        assert response.object.json_.to_dict(mode="json") == expected
        assert json.loads(response.object.json_.to_json()) == expected


def test_response_only_unknown_fields():
    payload = {"json": {"label": "root", "child": {"displayName": "child", "future": True}}, "future": {"value": 1}}
    transport = httpx.MockTransport(lambda request: httpx.Response(200, json=payload))
    with httpx.Client(transport=transport) as client:
        with SDK(server_url=HTTPBIN_URL, client=client) as sdk:
            response = sdk.echo_unknown_fields(request={"label": "root"})
    dumped = response.object.model_dump(mode="json", by_alias=True, exclude_none=not PRESERVE_UNKNOWN_FIELDS)
    assert ("future" in dumped) is PRESERVE_UNKNOWN_FIELDS
    assert ("future" in dumped["json"]["child"]) is PRESERVE_UNKNOWN_FIELDS


def test_typed_additional_properties_still_validate():
    with pytest.raises(pydantic.ValidationError):
        models.FieldEnvelopeInput.model_validate({"label": "root", "typed": {"future": {"invalid": True}}})


def test_unknown_fields_dump_filters():
    model = models.FieldEnvelopeInput.model_validate({"label": "root", "future": True, "future_null": None})
    assert ("future_null" in model.model_dump()) is PRESERVE_UNKNOWN_FIELDS
    assert "future_null" not in model.model_dump(exclude_none=True)
    assert "future" not in model.model_dump(exclude={"future"})
    assert model.model_dump(include={"label"}) == {"label": "root"}


def test_base_model_unknown_field_policy():
    class CustomModel(BaseModel):
        label: str

    model = CustomModel(label="value", future=None)
    assert ("future" in model.model_dump()) is PRESERVE_UNKNOWN_FIELDS


def test_unset_ignores_unknown_fields():
    node = models.FieldNode.model_validate({"displayName": "child", "nullable": {"future": True}})
    assert node.nullable == UNSET


def test_response_model_can_be_sent_again():
    payload = {"label": "root", "child": {"displayName": "child", "future": {"enabled": False}}}
    with SDK(server_url=HTTPBIN_URL) as sdk:
        first = sdk.echo_unknown_fields(request=payload)
        second = sdk.echo_unknown_fields(request=first.object.json_.model_dump(by_alias=True))
    expected = payload if PRESERVE_UNKNOWN_FIELDS else {"label": "root", "child": {"displayName": "child"}}
    assert second.http_meta.response.json()["json"] == expected
    assert second.object.json_.model_dump(by_alias=True, exclude_none=True) == expected


def test_error_response_unknown_fields():
    payload = {"message": "invalid", "future": None, "detail": {"displayName": "child", "future": {"flag": True}}}
    transport = httpx.MockTransport(lambda request: httpx.Response(400, json=payload))
    with httpx.Client(transport=transport) as client:
        with SDK(server_url=HTTPBIN_URL, client=client) as sdk:
            with pytest.raises(errors.SDKError) as caught:
                sdk.echo_unknown_fields(request={"label": "root"})
    data = getattr(caught.value, "data")
    dumped = data.model_dump(mode="json", by_alias=True)
    assert ("future" in dumped) is PRESERVE_UNKNOWN_FIELDS
    assert ("future" in dumped["detail"]) is PRESERVE_UNKNOWN_FIELDS


def test_omitted_json_query_stays_empty():
    with SDK(server_url=HTTPBIN_URL) as sdk:
        response = sdk.echo_optional_json_query()
    assert response.http_meta.response.request.url.params["filter"] == ""


@pytest.mark.parametrize("typ", [Optional[int], Optional[List[int]], Optional[models.FieldNode], Any])
def test_top_level_none_serialization(typ):
    assert utils.marshal_json(None, typ) == ""


def test_top_level_none_still_validates():
    with pytest.raises(pydantic.ValidationError):
        utils.marshal_json(None, models.FieldNode)
    assert utils.marshal_json(None, Nullable[models.FieldNode]) == "null"


def test_coerced_top_level_none_stays_empty():
    typ = Annotated[Optional[int], pydantic.BeforeValidator(lambda value: None)]
    assert utils.marshal_json("empty", typ) == ""


@pytest.mark.parametrize("typ, value", [(UnrecognizedStr, "future"), (UnrecognizedInt, 3)])
def test_unrecognized_enum_serialization(typ, value):
    adapter = pydantic.TypeAdapter(typ)
    enum_value = adapter.validate_python(value)
    assert isinstance(enum_value, typ)
    with warnings.catch_warnings():
        warnings.simplefilter("error")
        assert adapter.dump_python(enum_value) is enum_value
        assert adapter.dump_python(enum_value, mode="json") == value
        assert json.loads(adapter.dump_json(enum_value)) == value
    with pytest.raises(pydantic.ValidationError):
        adapter.validate_python(value, strict=True)


@pytest.mark.parametrize("options", [{}, {"use_api_names": False}, {"exclude_unset": False}, {"exclude_defaults": True}, {"exclude_none": True}, {"warnings": False}])
def test_model_serialization_methods(options):
    model = models.FieldEnvelopeInput.model_validate({"label": "root", "child": {"displayName": "child", "future": None}, "futureKind": "third", "futureCode": 3})
    if not MODEL_SERIALIZATION_METHODS:
        assert not hasattr(model, "to_dict")
        assert not hasattr(model, "to_json")
        return
    dump_options = {"by_alias": True, "exclude_unset": True, **options}
    if "use_api_names" in dump_options:
        dump_options["by_alias"] = dump_options.pop("use_api_names")
    assert model.to_dict(**options) == model.model_dump(**dump_options)
    assert model.to_dict(mode="json", **options) == model.model_dump(mode="json", **dump_options)
    assert model.to_json(indent=None, **options) == model.model_dump_json(indent=None, **dump_options)
    assert json.loads(model.to_json(**options)) == model.to_dict(mode="json", **options)


def test_model_serialization_methods_field_names():
    model = models.FieldEnvelopeInput.model_validate({"label": "root", "child": {"displayName": "child", "child": {"displayName": "grandchild"}}, "futureKind": "third", "plainChoice": {"text": "t"}, "future": True})
    extra = {"future": True} if PRESERVE_UNKNOWN_FIELDS else {}
    api_names = {"label": "root", "child": {"displayName": "child", "child": {"displayName": "grandchild"}}, "futureKind": "third", "plainChoice": {"text": "t"}, **extra}
    field_names = {"label": "root", "child": {"display_name": "child", "child": {"display_name": "grandchild"}}, "future_kind": "third", "plain_choice": {"text": "t"}, **extra}
    assert model.model_dump(exclude_unset=True) == api_names
    if not MODEL_SERIALIZATION_METHODS:
        return
    assert model.to_dict() == api_names
    assert model.to_dict(use_api_names=False) == field_names
    assert json.loads(model.to_json(use_api_names=False)) == field_names
    assert models.FieldEnvelopeInput.model_validate(model.to_dict(use_api_names=False)).to_dict() == api_names


def test_helper_names_reserved_only_on_models():
    expected_fields = {"to_dict_", "to_json_"} if MODEL_SERIALIZATION_METHODS else {"to_dict", "to_json"}
    assert set(models.MethodNames.model_fields) == expected_fields
    with SDK(server_url=HTTPBIN_URL) as sdk:
        response = sdk.to_json.echo_grouped_fields()
    assert response.http_meta.response.status_code == 200


def test_model_serialization_methods_keep_consts():
    model = models.FieldEnvelopeInput(label="root", choice=models.TextChoice(text="t"), constant=models.ConstFields())
    expected = {"label": "root", "choice": {"kind": "text", "text": "t"}, "constant": {"kind": "fixed"}}
    wire = {"label": "root", "choice": {"kind": "text", "text": "t"}, "constant": {"kind": "fixed", "priority": 1}}
    assert json.loads(utils.marshal_json(model, models.FieldEnvelopeInput)) == wire
    if not MODEL_SERIALIZATION_METHODS:
        return
    assert model.to_dict() == expected
    assert model.to_dict(exclude_unset=False) == wire
    assert json.loads(model.to_json()) == expected
    assert models.FieldEnvelopeInput.model_validate(model.to_dict()).to_dict() == expected
    assert models.FieldEnvelopeInput.model_validate(wire).to_dict() == wire
    assert models.ConstFields(priority=1).to_dict() == {"kind": "fixed", "priority": 1}
    assert models.ConstFields(priority=1).to_dict(exclude_defaults=True) == {}
    assert models.ConstFields(priority=2).to_dict(exclude_defaults=True) == {"priority": 2}
