{{- recurse 1 -}}
{{- addImport "github.com/spf13/cobra" -}}
{{- addImport "internal/config" true -}}
{{- if isAnyInteractiveEnabled -}}
{{- addImport "internal/flagutil" true -}}
{{- end -}}
{{- addImport "internal/client" true -}}
{{- addImport "internal/usage" true -}}
{{- if isAnyInteractiveEnabled -}}
{{- addImport "internal/interactive" true -}}
{{- addImport "internal/output" true -}}
{{- addImport "strings" -}}
{{- end -}}
{{- addImport "fmt" -}}
{{- addImport "encoding/json" -}}
{{- if isInteractiveAuthEnabled -}}
{{- addImport "internal/forms" true -}}
{{- else -}}
{{- addImport "bufio" -}}
{{- addImport "strings" -}}
{{- end -}}
package cli

{{genImports}}

// initConfigureCmd initializes the configure command.
func initConfigureCmd(parent *cobra.Command) error {
    var cmd = &cobra.Command{
        Use:   "configure",
        Short: "{{templateConfigureShort}}",
        Long:  `{{templateConfigureLong}}`,
        Args:  cobra.NoArgs,
        RunE:  runConfigureCmd,
    }
    cmd.Annotations = map[string]string{"speakeasy_settings_command": "true"}
    {{- if and (eq (helpStyle) "compact") (isAnyInteractiveEnabled)}}
    cmd.Example = "{{templateSettingsHelpExample "configure"}}"
    cmd.Annotations["speakeasy_help_settings"] = "{{templateSettingsHelpFlags "configure"}}"
    cmd.Annotations["speakeasy_help_see_also"] = "{{templateSettingsHelpSeeAlso "configure"}}"
    {{- end}}
    {{- if isAnyInteractiveEnabled}}
    cmd.Flags().String("{{defaultOutputFormatFlag}}", "", "Store the default output format without opening the form. Options: "+strings.Join(output.Formats, ", ")+". Pass an empty value to clear it.")
    cmd.Flags().StringSlice("{{configureClearFlag}}", nil, "Remove stored values without opening the form (repeatable or comma-separated). Options: {{templateConfigureClearOptions}}")
    {{- end}}
    parent.AddCommand(cmd)
    return nil
}

// runConfigureCmd executes the configure command.
func runConfigureCmd(cmd *cobra.Command, args []string) error {
    if usage.UsageRequested(cmd) {
        return usage.EmitSchema(cmd, cmd.OutOrStdout())
    }
    if dryRunLocalNoop(cmd, "configure changes local settings only (no API request); nothing was changed.") {
        return nil
    }
    cfg := config.GetConfig()
    if cfg == nil {
        cfg = &config.Config{}
    }
    {{- if hasSecretCLIFields}}

    keychainStored := false
    {{- end}}
    {{- if isAnyInteractiveEnabled}}

    var cleared []string
    formMode := interactive.Resolve(cmd).SetupFormMode(flagutil.AnyFlagChanged(cmd, {{templateConfigureFlagNames}}))
    if cmd.Flags().Changed("{{defaultOutputFormatFlag}}") || cmd.Flags().Changed("{{configureClearFlag}}") {
        formMode = interactive.FormOff
    }
    {{- end}}

{{- if isInteractiveAuthEnabled}}
    if formMode == interactive.FormOff {
        {{templateConfigureNonInteractiveStore | indent 8 | trim}}
    } else {
        {{- if hasGlobalSecurity}}
        {{templateAuthLoginVarDeclarations | indent 8 | trim}}
        {{- end}}
        {{- if hasGlobals}}
        {{templateConfigureGlobalVarDeclarations | indent 8 | trim}}
        {{- end}}
        accessible := formMode == interactive.FormAccessible

        var pages []*forms.Page

        {{- if hasGlobalSecurity}}
        securityFields := []*forms.Field{
            {{templateAuthLoginFormFields | indent 12 | trim}}
        }
        pages = append(pages, forms.NewPage("Authentication", securityFields...))
        {{- end}}

        {{- if hasGlobals}}
        globalFields := []*forms.Field{
            {{templateConfigureGlobalFormFields | indent 12 | trim}}
        }
        pages = append(pages, forms.NewPage("Global Parameters", globalFields...))
        {{- end}}

        // Preferences are only offered in the interactive form; line prompts
        // cover credentials and global parameters.
        {{templateConfigurePreferenceVarDeclarations | indent 8 | trim}}
        if !accessible {
            preferenceFields := []*forms.Field{
                {{templateConfigurePreferenceFormFields | indent 16 | trim}}
            }
            pages = append(pages, forms.NewPage("Preferences", preferenceFields...))
        }

        form := forms.New(pages...).Accessible(accessible).IO(cmd.InOrStdin(), cmd.OutOrStdout())

        if err := form.Run(); err != nil {
            return fmt.Errorf("configure: %w", err)
        }

        {{- if hasGlobalSecurity}}
        {{templateAuthLoginStore | indent 8 | trim}}
        {{- end}}
        {{- if hasGlobals}}
        {{templateConfigureGlobalStore | indent 8 | trim}}
        {{- end}}
        if !accessible {
            {{templateConfigurePreferenceStore | indent 12 | trim}}
        }
    }
{{- else}}
    {{- if isAnyInteractiveEnabled}}
    if formMode == interactive.FormOff {
        {{templateConfigureNonInteractiveStore | indent 8 | trim}}
    } else {
    {{- end}}
    out := cmd.OutOrStdout()
    fmt.Fprintln(out, "Configure {{sanitizeCliName}}")
    fmt.Fprintln(out, "Press Enter to keep the current value, or enter a new value.")
    fmt.Fprintln(out, "Enter - to clear a previously set value.")
    fmt.Fprintln(out, "Leave empty to skip a setting you don't use.")
    fmt.Fprintln(out)

    // reader is shared across all prompt sections
    reader := bufio.NewReader(cmd.InOrStdin())

    {{- if hasGlobalSecurity}}
    {{- if or (hasGlobals) true}}
    fmt.Fprintln(out, "Authentication:")
    fmt.Fprintln(out)
    {{- end}}
    {{templateConfigurePrompts | indent 4 | trim}}
    {{- end}}
    {{- if hasGlobals}}
    {{- if hasGlobalSecurity}}
    fmt.Fprintln(out)
    {{- end}}
    fmt.Fprintln(out, "Global Parameters:")
    fmt.Fprintln(out)
    {{templateConfigureGlobalPrompts | indent 4 | trim}}
    {{- end}}
    {{- if or (hasGlobalSecurity) (hasGlobals)}}
    fmt.Fprintln(out)
    {{- end}}
    fmt.Fprintln(out, "Preferences:")
    fmt.Fprintln(out)
    {{templateConfigurePreferences | indent 4 | trim}}
    {{- if isAnyInteractiveEnabled}}
    }
    {{- end}}
{{- end}}

    if err := config.SaveConfig(cfg); err != nil {
        return fmt.Errorf("failed to save configuration: %w", err)
    }

    {{- if isAnyInteractiveEnabled}}
    if output.IsMachineMode(cmd) {
        result := map[string]any{"config_file": config.GetConfigPath()}
        {{- if hasSecretCLIFields}}
        result["keychain_stored"] = keychainStored
        {{- end}}
        if len(cleared) > 0 {
            result["cleared"] = cleared
        }
        return output.LocalResult(cmd, result)
    }
    {{- end}}
    out{{if isAnyInteractiveEnabled}} :{{end}}= cmd.OutOrStdout()
    {{- if hasSecretCLIFields}}
    if keychainStored {
        fmt.Fprintln(out, "Secret credentials stored in OS keychain")
    }
    {{- end}}
    {{- if isAnyInteractiveEnabled}}
    for _, name := range cleared {
        fmt.Fprintf(out, "Cleared --%s\n", name)
    }
    {{- end}}
    fmt.Fprintf(out, "Configuration saved to %s\n", config.GetConfigPath())
    return nil
}

// dryRunLocalNoop implements the append-safe dry-run contract for local
// mutation commands: no prompts, keychain access, or filesystem writes. The
// machine preview protocol still receives an explicit local no-op record —
// silence would be indistinguishable from a failed preview.
func dryRunLocalNoop(cmd *cobra.Command, message string) bool {
    if !client.IsDryRun(cmd) {
        return false
    }
    if client.IsJSONDryRun(cmd) {
        enc := json.NewEncoder(cmd.OutOrStdout())
        enc.SetEscapeHTML(false)
        _ = enc.Encode(struct {
            DryRun  bool   `json:"dry_run"`
            Local   bool   `json:"local"`
            Command string `json:"command"`
            Message string `json:"message"`
        }{DryRun: true, Local: true, Command: cmd.CommandPath(), Message: message})
    } else {
        fmt.Fprintln(cmd.ErrOrStderr(), "[DRY-RUN] "+message)
    }
    return true
}
