{{- if and (isInteractiveModeEnabled) (templateArtifactInteractiveTestEnabled)}}
type artifactPrompter struct {
	answers map[string][]string
	fields  []interactive.PromptField
	calls   int
}

func (p *artifactPrompter) Prompt(_ *cobra.Command, fields []interactive.PromptField) ([]interactive.PromptAnswer, error) {
	p.calls++
	p.fields = append([]interactive.PromptField(nil), fields...)
	answers := make([]interactive.PromptAnswer, len(fields))
	for i, field := range fields {
		if values, ok := p.answers[field.ID]; ok {
			answers[i] = interactive.PromptAnswer{Set: true, Values: values}
		}
	}
	return answers, nil
}

func runArtifactInteractive(t *testing.T, h *CLITestHarness, serverURL, dir string, p interactive.Prompter, extra ...string) error {
	t.Helper()
	orig, err := os.Getwd()
	require.NoError(t, err)
	require.NoError(t, os.Chdir(dir))
	t.Cleanup(func() { _ = os.Chdir(orig) })
	h.resetAndSetupEnv()
	rootCmd, err := cli.NewRootCommand()
	require.NoError(t, err)
	rootCmd.SetOut(h.stdout)
	rootCmd.SetErr(h.stderr)
	// Prompting is opt-in at runtime (--interactive; interactiveByDefault may be false).
	args := []string{"--interactive", "--server-url", serverURL, "--color", "never", {{templateArtifactTestPathArgs}}}
	args = append(args, extra...)
	ctx := interactive.WithPrompter(context.Background(), p)
	return cli.ExecuteRoot(ctx, rootCmd, args)
}

func TestArtifact_InteractiveOutputFileIsDirect(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	target := filepath.Join(dir, "chosen{{templateArtifactTestExt}}")
	p := &artifactPrompter{answers: map[string][]string{
		"arg:" + {{templateArtifactTestPromptArg}}: {"interactive artifact"},
		"flag:out": {target},
	}}
	h := NewCLITestHarness(t)
	require.NoError(t, runArtifactInteractive(t, h, server.URL, dir, p))
	assert.Equal(t, target, strings.TrimSpace(h.GetStdout()))
	require.GreaterOrEqual(t, len(p.fields), 2)
	assert.Equal(t, "arg:"+{{templateArtifactTestPromptArg}}, p.fields[0].ID)
	assert.Equal(t, "flag:out", p.fields[1].ID)
	assert.True(t, p.fields[1].Direct)
	assert.Equal(t, "Output file", p.fields[1].Name)
	assert.Contains(t, p.fields[1].Summary, "into this directory")
	assert.Contains(t, p.fields[1].Summary, "{{templateArtifactTestDefaultPath}}")
	assert.Contains(t, p.fields[1].Summary, "optional; leave empty for the default")
}

func TestArtifact_InteractiveEmptyOutputUsesDefault(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	p := &artifactPrompter{answers: map[string][]string{
		"arg:" + {{templateArtifactTestPromptArg}}: {"default artifact"},
	}}
	h := NewCLITestHarness(t)
	require.NoError(t, runArtifactInteractive(t, h, server.URL, dir, p))
	printed := strings.TrimSpace(h.GetStdout())
	realDir, err := filepath.EvalSymlinks(dir)
	require.NoError(t, err)
	assert.Equal(t, realDir, filepath.Dir(printed))
	assert.True(t, strings.HasSuffix(printed, "{{templateArtifactTestExt}}"))
}

func TestArtifact_InteractivePresetOutIsNotPrompted(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	target := filepath.Join(dir, "preset{{templateArtifactTestExt}}")
	p := &artifactPrompter{answers: map[string][]string{
		"arg:" + {{templateArtifactTestPromptArg}}: {"preset output"},
	}}
	h := NewCLITestHarness(t)
	require.NoError(t, runArtifactInteractive(t, h, server.URL, dir, p, "--out", target))
	for _, field := range p.fields {
		assert.NotEqual(t, "flag:out", field.ID)
	}
}

func TestArtifact_InteractiveCompleteArgDoesNotPromptOutputFile(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	p := &artifactPrompter{}
	h := NewCLITestHarness(t)
	require.NoError(t, runArtifactInteractive(t, h, server.URL, dir, p, "complete artifact prompt"))
	assert.Zero(t, p.calls, "a direct output field must not create a form when argv already satisfies required inputs")
	printed := strings.TrimSpace(h.GetStdout())
	realDir, err := filepath.EvalSymlinks(dir)
	require.NoError(t, err)
	assert.Equal(t, realDir, filepath.Dir(printed))
	assert.True(t, strings.HasSuffix(printed, "{{templateArtifactTestExt}}"))
}

func TestArtifact_InteractiveSuppressedByNonInteractiveAndAgentModes(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	// (A flat slice: a nested-slice literal opens with a double brace, which
	// the template engine reads as an action delimiter.)
	for _, mode := range []string{"--no-interactive", "--agent-mode"} {
		t.Run(strings.TrimPrefix(mode, "--"), func(t *testing.T) {
			dir := t.TempDir()
			p := &artifactPrompter{}
			h := NewCLITestHarness(t)
			err := runArtifactInteractive(t, h, server.URL, dir, p, mode)
			assert.Zero(t, p.calls)
			if err == nil {
				assert.Contains(t, h.GetStdout(), "Usage:")
			} else {
				assert.NotEmpty(t, err.Error(), "a suppressed bare invocation may return its established usage error")
			}
			entries, readErr := os.ReadDir(dir)
			require.NoError(t, readErr)
			assert.Empty(t, entries, "a suppressed prompt must not write an artifact")
		})
	}
}
{{- end}}

{{- if templateArtifactTestOutcomeFailureState}}
// A declared failure state (output.outcome) fails the command before any
// media is written.
func TestArtifact_DeclaredFailureStateWritesNothing(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestOutcomeFailureJSON templateArtifactTestMime}}`)
	dir := t.TempDir()
	h := NewCLITestHarness(t)

	err := runArtifact(t, h, server.URL, dir)
	require.Error(t, err)
	assert.Contains(t, err.Error(), "ended in failure state "+{{printf "%q" (printf "%q" templateArtifactTestOutcomeFailureState)}})
	assert.Empty(t, strings.TrimSpace(h.GetStdout()))
	entries, err := os.ReadDir(dir)
	require.NoError(t, err)
	assert.Empty(t, entries, "a failure state must not write the artifact")
}
