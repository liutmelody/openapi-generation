// Artifact commands (x-speakeasy-cli-commands output.artifact) write the
// declared media content to a file and report the path. These tests drive the
// "{{templateArtifactTestArgs}}" command against a stub server that returns
// content shaped to the command's declared content pointer.

const artifactTestBytes = "artifact-bytes" // base64: YXJ0aWZhY3QtYnl0ZXM=

func artifactTestServer(t *testing.T, body string) *httptest.Server {
	t.Helper()
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader({{templateArtifactTestStatus}})
		_, _ = w.Write([]byte(body))
	}))
	t.Cleanup(server.Close)
	return server
}

// runArtifact executes the artifact command with the working directory set to
// dir (default filenames resolve against it) and no forced output format.
func runArtifact(t *testing.T, h *CLITestHarness, serverURL, dir string, extra ...string) error {
	t.Helper()
	orig, err := os.Getwd()
	require.NoError(t, err)
	require.NoError(t, os.Chdir(dir))
	t.Cleanup(func() { _ = os.Chdir(orig) })
	args := append([]string{ {{templateArtifactTestArgs}} }, extra...)
	return h.RunWithStdinServerRaw(serverURL, args, "")
}

func TestArtifact_DefaultPathPrintsAbsolutePathOnly(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	h := NewCLITestHarness(t)

	require.NoError(t, runArtifact(t, h, server.URL, dir))

	stdout := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, stdout, "stdout must carry the artifact path")
	assert.Len(t, strings.Split(stdout, "\n"), 1, "stdout must be exactly one path line")
	assert.True(t, filepath.IsAbs(stdout), "printed path must be absolute: %q", stdout)
	assert.True(t, strings.HasSuffix(stdout, "{{templateArtifactTestExt}}"), "extension must follow the returned MIME type: %q", stdout)
	written, err := os.ReadFile(stdout)
	require.NoError(t, err)
	assert.Equal(t, artifactTestBytes, string(written))
	assert.Contains(t, h.GetStderr(), "Wrote {{templateArtifactTestKind}} to ")

	// A second run must not overwrite the first artifact.
	h2 := NewCLITestHarness(t)
	require.NoError(t, runArtifact(t, h2, server.URL, dir))
	second := strings.TrimSpace(h2.GetStdout())
	assert.NotEqual(t, stdout, second, "default filenames must never collide")
	_, err = os.Stat(stdout)
	assert.NoError(t, err, "first artifact must survive a second run")
}

{{- /* Without a [*] the pointer has one candidate and nothing to choose. */}}
{{- if templateArtifactTestPointerHasWild}}
// Two blocks of the declared kind: the final one must be written.
func TestArtifact_WritesLastMatchingBlock(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "multiple" templateArtifactTestMime}}`)
	dir := t.TempDir()
	h := NewCLITestHarness(t)

	require.NoError(t, runArtifact(t, h, server.URL, dir))

	stdout := strings.TrimSpace(h.GetStdout())
	written, err := os.ReadFile(stdout)
	require.NoError(t, err)
	assert.Equal(t, artifactTestBytes, string(written), "the last block of the declared kind must be written, not an earlier one")
}

func TestArtifact_TrailingBlockWithoutDataIsAnError(t *testing.T) {
	for name, body := range map[string]string{
		"missing": `{{templateArtifactTestMockJSON "multiple-missing-data" templateArtifactTestMime}}`,
		"empty":   `{{templateArtifactTestMockJSON "multiple-empty-data" templateArtifactTestMime}}`,
	} {
		t.Run(name, func(t *testing.T) {
			server := artifactTestServer(t, body)
			dir := t.TempDir()
			h := NewCLITestHarness(t)

			err := runArtifact(t, h, server.URL, dir)
			require.Error(t, err)
			assert.Contains(t, err.Error(), "no {{templateArtifactTestKind}} content")
			assert.Empty(t, strings.TrimSpace(h.GetStdout()))
			entries, err := os.ReadDir(dir)
			require.NoError(t, err)
			assert.Empty(t, entries, "a trailing block without data must not write an earlier artifact")
		})
	}
}
{{- end}}

func TestArtifact_OutFileIsUsedAndOverwritten(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	target := filepath.Join(dir, "nested", "asset{{templateArtifactTestExt}}")
	h := NewCLITestHarness(t)

	require.NoError(t, runArtifact(t, h, server.URL, dir, "--out", target))
	assert.Equal(t, target, strings.TrimSpace(h.GetStdout()))
	written, err := os.ReadFile(target)
	require.NoError(t, err)
	assert.Equal(t, artifactTestBytes, string(written))
	assert.NotContains(t, h.GetStderr(), "Note: wrote", "an unchanged extension needs no rewrite note")

	// Explicit destinations replace an existing file (matching the reference UX).
	require.NoError(t, os.WriteFile(target, []byte("stale"), 0o644))
	h2 := NewCLITestHarness(t)
	require.NoError(t, runArtifact(t, h2, server.URL, dir, "--out", target))
	written, err = os.ReadFile(target)
	require.NoError(t, err)
	assert.Equal(t, artifactTestBytes, string(written))
}

func TestArtifact_OutExtensionFollowsReturnedMime(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	h := NewCLITestHarness(t)

	require.NoError(t, runArtifact(t, h, server.URL, dir, "--out", filepath.Join(dir, "photo{{templateArtifactTestWrongExt}}")))
	printed := strings.TrimSpace(h.GetStdout())
	assert.Equal(t, filepath.Join(dir, "photo{{templateArtifactTestExt}}"), printed)
	_, err := os.Stat(printed)
	assert.NoError(t, err)
	assert.Contains(t, h.GetStderr(), "Note: wrote {{templateArtifactTestMime}} as photo{{templateArtifactTestExt}} (requested photo{{templateArtifactTestWrongExt}})")
}

func TestArtifact_OutWithoutExtensionAppendsSilently(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	h := NewCLITestHarness(t)
	target := filepath.Join(dir, "photo")

	require.NoError(t, runArtifact(t, h, server.URL, dir, "--out", target))
	assert.Equal(t, target+"{{templateArtifactTestExt}}", strings.TrimSpace(h.GetStdout()))
	assert.NotContains(t, h.GetStderr(), "Note: wrote", "plain extension appends are not rewrites")
}

func TestArtifact_ExtensionRewriteNoteIsSilentInAgentMode(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	h := NewCLITestHarness(t)
	target := filepath.Join(dir, "photo.wrong")

	// Machine modes keep stderr silent on success; the final path is already
	// the deliverable on stdout, so the human rewrite note is suppressed.
	require.NoError(t, runArtifact(t, h, server.URL, dir, "--agent-mode", "--out", target))
	assert.Empty(t, strings.TrimSpace(h.GetStderr()), "machine-mode success must keep stderr silent")
	assert.Contains(t, h.GetStdout(), "photo{{templateArtifactTestExt}}")
}

func TestArtifact_OutDirectoryUsesDefaultName(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	outDir := filepath.Join(dir, "renders")
	require.NoError(t, os.MkdirAll(outDir, 0o755))
	h := NewCLITestHarness(t)

	require.NoError(t, runArtifact(t, h, server.URL, dir, "--out", outDir))
	printed := strings.TrimSpace(h.GetStdout())
	assert.Equal(t, outDir, filepath.Dir(printed))
	assert.True(t, strings.HasSuffix(printed, "{{templateArtifactTestExt}}"))
}

func TestArtifact_StructuredModesReportEnvelopeAndWriteFile(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()

	h := NewCLITestHarness(t)
	target := filepath.Join(dir, "json{{templateArtifactTestExt}}")
	require.NoError(t, runArtifact(t, h, server.URL, dir, "--out", target, "--output-format", "json"))
	stdout := h.GetStdout()
	assert.Equal(t, target, jsonGetString(stdout, "path"))
	assert.Equal(t, "{{templateArtifactTestKind}}", jsonGetString(stdout, "kind"))
	assert.Equal(t, "{{templateArtifactTestMime}}", jsonGetString(stdout, "mime_type"))
	assert.Equal(t, float64(len(artifactTestBytes)), jsonGetFloat64(stdout, "size_bytes"))
	assert.NotContains(t, stdout, base64.StdEncoding.EncodeToString([]byte(artifactTestBytes)), "structured output must not carry payload bytes")
	assert.Empty(t, h.GetStderr(), "machine-mode success must keep stderr silent")
	_, err := os.Stat(target)
	assert.NoError(t, err)

	// --jq projects the artifact envelope, not the raw API response.
	h2 := NewCLITestHarness(t)
	target2 := filepath.Join(dir, "jq{{templateArtifactTestExt}}")
	require.NoError(t, runArtifact(t, h2, server.URL, dir, "--out", target2, "--jq", ".path"))
	assert.Equal(t, `"`+target2+`"`, strings.TrimSpace(h2.GetStdout()))
	assert.Empty(t, h2.GetStderr(), "--jq success must keep stderr silent")
	_, err = os.Stat(target2)
	assert.NoError(t, err)

	// Explicit agent mode reports the compact envelope too.
	h3 := NewCLITestHarness(t)
	target3 := filepath.Join(dir, "agent{{templateArtifactTestExt}}")
	require.NoError(t, runArtifact(t, h3, server.URL, dir, "--agent-mode", "--out", target3))
	assert.Contains(t, h3.GetStdout(), target3)
	assert.NotContains(t, h3.GetStdout(), "YXJ0aWZhY3QtYnl0ZXM=")
	assert.Empty(t, h3.GetStderr(), "agent-mode success must keep stderr silent")
	_, err = os.Stat(target3)
	assert.NoError(t, err)

	for _, format := range []string{"yaml", "toon"} {
		t.Run(format, func(t *testing.T) {
			h := NewCLITestHarness(t)
			target := filepath.Join(dir, format+"{{templateArtifactTestExt}}")
			require.NoError(t, runArtifact(t, h, server.URL, dir, "--out", target, "--output-format", format))
			assert.Contains(t, h.GetStdout(), target)
			assert.Empty(t, h.GetStderr(), "structured success must keep stderr silent")
		})
	}
}

func TestArtifact_RawResponseBypassesFile(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	h := NewCLITestHarness(t)

	require.NoError(t, runArtifact(t, h, server.URL, dir, "--raw-response", "--output-format", "json"))
	assert.Contains(t, h.GetStdout(), "YXJ0aWZhY3QtYnl0ZXM=", "raw response must include the API payload")
	entries, err := os.ReadDir(dir)
	require.NoError(t, err)
	assert.Empty(t, entries, "--raw-response must not write a file")

	h2 := NewCLITestHarness(t)
	err = runArtifact(t, h2, server.URL, dir, "--raw-response", "--out", filepath.Join(dir, "x"))
	require.Error(t, err)
	assert.Contains(t, err.Error(), "cannot be combined with --out")
}

func TestArtifact_OutputFormatValueSuggestsOut(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()

	for _, val := range []string{"asset{{templateArtifactTestExt}}", "asset.yaml", "renders/"} {
		h := NewCLITestHarness(t)
		err := runArtifact(t, h, server.URL, dir, "--agent-mode", "-o", val)
		require.Error(t, err)
		assert.Contains(t, err.Error(), fmt.Sprintf("invalid value %q for -o/--output-format", val))
		var envelope struct {
			Hints []string `json:"hints"`
		}
		require.NoError(t, json.Unmarshal([]byte(h.GetStderr()), &envelope), h.GetStderr())
		require.NotEmpty(t, envelope.Hints)
		assert.Equal(t, "-o sets the output format. To write to a file, use --out "+val, envelope.Hints[0])
	}

	for _, flag := range []string{"-o", "--output-format"} {
		h := NewCLITestHarness(t)
		err := runArtifact(t, h, server.URL, dir, "--agent-mode", flag, "jsno")
		require.Error(t, err)
		assert.Contains(t, err.Error(), `did you mean "json"`)
		var envelope struct {
			Hints []string `json:"hints"`
		}
		require.NoError(t, json.Unmarshal([]byte(h.GetStderr()), &envelope), h.GetStderr())
		for _, hint := range envelope.Hints {
			assert.NotContains(t, hint, "--out", flag)
		}
	}

	h := NewCLITestHarness(t)
	err := runArtifact(t, h, server.URL, dir, "--agent-mode", "-o", "json", "--out")
	require.Error(t, err)
	assert.Contains(t, err.Error(), "flag needs an argument: --out")
	var envelope struct {
		Hints []string `json:"hints"`
	}
	require.NoError(t, json.Unmarshal([]byte(h.GetStderr()), &envelope), h.GetStderr())
	for _, hint := range envelope.Hints {
		assert.NotContains(t, hint, "is short for")
	}

	h = NewCLITestHarness(t)
	err = runArtifact(t, h, server.URL, dir, "--agent-mode", "--output", "asset{{templateArtifactTestExt}}")
	require.Error(t, err)
	assert.Contains(t, err.Error(), "unknown flag: --output")
	envelope.Hints = nil
	require.NoError(t, json.Unmarshal([]byte(h.GetStderr()), &envelope), h.GetStderr())
	require.NotEmpty(t, envelope.Hints)
	assert.Equal(t, "Did you mean --out?", envelope.Hints[0])

	entries, err := os.ReadDir(dir)
	require.NoError(t, err)
	assert.Empty(t, entries, "a rejected invocation must not write a file")
}

func TestArtifact_DryRunWritesNothing(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	h := NewCLITestHarness(t)

	target := filepath.Join(dir, "new", "nested", "asset{{templateArtifactTestExt}}")
	require.NoError(t, runArtifact(t, h, server.URL, dir, "--dry-run", "--out", target))
	entries, err := os.ReadDir(dir)
	require.NoError(t, err)
	assert.Empty(t, entries, "--dry-run must not write a file")
	assert.Empty(t, h.GetStdout(), "human dry-run must not print a synthetic artifact")
	assert.Contains(t, h.GetStderr(), "[DRY-RUN]")
	_, err = os.Stat(filepath.Dir(target))
	assert.True(t, os.IsNotExist(err), "--dry-run must not create output directories")

	jsonDir := t.TempDir()
	jsonTarget := filepath.Join(jsonDir, "new", "nested", "asset{{templateArtifactTestExt}}")
	jsonHarness := NewCLITestHarness(t)
	require.NoError(t, runArtifact(t, jsonHarness, server.URL, jsonDir, "--dry-run", "--out", jsonTarget, "--output-format", "json"))
	assert.Empty(t, jsonHarness.GetStderr(), "successful JSON dry-run must keep stderr empty")
	stdout := jsonHarness.GetStdout()
	assert.Equal(t, 1, strings.Count(stdout, string(rune(10))), "JSON dry-run must emit exactly one preview line")
	var preview struct {
		DryRun bool `json:"dry_run"`
	}
	require.NoError(t, json.Unmarshal([]byte(strings.TrimSpace(stdout)), &preview))
	assert.True(t, preview.DryRun)
	entries, err = os.ReadDir(jsonDir)
	require.NoError(t, err)
	assert.Empty(t, entries, "JSON dry-run must not write a file")
	_, err = os.Stat(filepath.Dir(jsonTarget))
	assert.True(t, os.IsNotExist(err), "JSON dry-run must not create output directories")
}

func TestArtifact_MissingContentIsAnError(t *testing.T) {
	dir := t.TempDir()

	for name, body := range map[string]string{
		"empty":     `{{templateArtifactTestMockJSON "empty" templateArtifactTestMime}}`,
		"wrongkind": `{{templateArtifactTestMockJSON "wrongkind" templateArtifactTestMime}}`,
	} {
		t.Run(name, func(t *testing.T) {
			server := artifactTestServer(t, body)
			h := NewCLITestHarness(t)
			err := runArtifact(t, h, server.URL, dir)
			require.Error(t, err)
			assert.Contains(t, err.Error(), "no {{templateArtifactTestKind}} content")
			assert.Empty(t, strings.TrimSpace(h.GetStdout()), "stdout must stay empty on failure")
		})
	}

	entries, err := os.ReadDir(dir)
	require.NoError(t, err)
	assert.Empty(t, entries)
}

func TestArtifact_URIDeliveryIsUnsupported(t *testing.T) {
