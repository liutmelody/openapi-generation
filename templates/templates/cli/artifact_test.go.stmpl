// The content-block and job-identity shape is declaration-driven: the
// annotation below is the real command's generated annotation with every
// binding renamed at generation time (a fixed prefix on each declared or
// defaulted member name, so the synthetic shape is guaranteed distinct from
// the real one whatever the document declares). Injecting it over the
// generated command and serving a body in that shape proves the runtime
// reads the declared members — a runtime that assumed the default names
// would find no content.
const artifactCustomShapeAnnotation = "{{escapeGoString templateArtifactTestCustomAnnotation}}"

// runArtifactCustomShape mirrors runArtifact but rebinds the artifact
// command's speakeasy_artifact annotation to artifactCustomShapeAnnotation
// on a fresh command tree before executing.
func runArtifactCustomShape(t *testing.T, h *CLITestHarness, serverURL, dir string, extra ...string) error {
	t.Helper()
	orig, err := os.Getwd()
	require.NoError(t, err)
	require.NoError(t, os.Chdir(dir))
	t.Cleanup(func() { _ = os.Chdir(orig) })
	h.resetAndSetupEnv()
	rootCmd, err := cli.NewRootCommand()
	require.NoError(t, err)
	rootCmd.SetOut(h.stdout)
	rootCmd.SetErr(h.stderr)
	rootCmd.SetIn(strings.NewReader(""))

	target := rootCmd
	for _, segment := range []string{ {{templateArtifactTestPathArgs}} } {
		found := false
		for _, child := range target.Commands() {
			if child.Name() == segment {
				target = child
				found = true
				break
			}
		}
		require.True(t, found, "artifact command segment %q not found", segment)
	}
	require.Contains(t, target.Annotations, "speakeasy_artifact")
	annotations := map[string]string{}
	for key, value := range target.Annotations {
		annotations[key] = value
	}
	annotations["speakeasy_artifact"] = artifactCustomShapeAnnotation
	target.Annotations = annotations

	args := append([]string{ {{templateArtifactTestArgs}} }, extra...)
	fullArgs := append(append(baseArgs(), "--server-url", serverURL, "--color", "never"), args...)
	return cli.ExecuteRoot(context.Background(), rootCmd, fullArgs)
}

func TestArtifact_DeclaredShapeDrivesExtraction(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestCustomMockJSON "inline" templateArtifactTestMime}}`)
	dir := t.TempDir()
	h := NewCLITestHarness(t)

	require.NoError(t, runArtifactCustomShape(t, h, server.URL, dir, "--output-format", "json"))
	stdout := h.GetStdout()
	written := jsonGetString(stdout, "path")
	require.NotEmpty(t, written, "envelope must carry the artifact path")
	payload, err := os.ReadFile(written)
	require.NoError(t, err)
	assert.Equal(t, artifactTestBytes, string(payload))
	assert.Equal(t, "{{templateArtifactTestMime}}", jsonGetString(stdout, "mime_type"))
	{{- if templateArtifactTestRootIsObject}}
	assert.Equal(t, "task-123", jsonGetString(stdout, "response_id"), "identity idField binding must feed response_id")
	assert.Equal(t, {{goStringLiteral templateArtifactTestCustomTerminalStatus}}, jsonGetString(stdout, "status"), "identity statusField binding must feed status")
	{{- end}}

	// The same custom-shaped body must NOT satisfy the default-shape command:
	// the declaration, not a hardcoded probe, decides the member names.
	h2 := NewCLITestHarness(t)
	err = runArtifact(t, h2, server.URL, dir)
	require.Error(t, err)
	assert.Contains(t, err.Error(), "no {{templateArtifactTestKind}} content")
}

{{- if templateArtifactTestRootIsObject}}

func TestArtifact_DeclaredShapeNotReadyDiagnostics(t *testing.T) {
	server := artifactTestServer(t, `{{templateArtifactTestCustomMockJSON "notready" templateArtifactTestMime}}`)
	dir := t.TempDir()
	h := NewCLITestHarness(t)

	err := runArtifactCustomShape(t, h, server.URL, dir)
	require.Error(t, err)
	assert.Contains(t, err.Error(), "no {{templateArtifactTestKind}} content")
	assert.Contains(t, err.Error(), `status "artifact_test_pending"`, "the declared statusField and terminalStatus drive the not-ready diagnostic")
	assert.Contains(t, err.Error(), `id "task-123"`, "the declared idField feeds the not-ready diagnostic")
	assert.Contains(t, err.Error(), "may not be ready yet")
}
