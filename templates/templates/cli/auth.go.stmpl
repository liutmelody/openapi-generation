{{- recurse 1 -}}
{{- addImport "github.com/spf13/cobra" -}}
{{- addImport "internal/config" true -}}
{{- addImport "internal/flagutil" true -}}
{{- if templateHasSecuritySchemeGroups}}{{- addImport "internal/interactive" true -}}{{- addImport "internal/forms" true -}}{{- end}}
{{- addImport "fmt" -}}
{{- addImport "internal/output" true -}}
package cli

{{genImports}}

// initAuthCmd registers the auth command group with login, whoami, and logout subcommands.
func initAuthCmd(parent *cobra.Command) error {
    var authCmd *cobra.Command
    for _, existing := range parent.Commands() {
        if existing.Name() == "auth" || existing.HasAlias("auth") {
            authCmd = existing
            break
        }
    }
    if authCmd == nil {
        authCmd = &cobra.Command{
            Use:   "auth",
            Short: "Manage authentication credentials",
            Long: `Manage authentication credentials for {{sanitizeCliName}}.

Subcommands:
  login   - Interactively configure credentials
  whoami  - Display current authentication status
  logout  - Clear all stored credentials`,
        }
        parent.AddCommand(authCmd)
    }

    addAuthSubcommand := func(sub *cobra.Command) {
        for _, existing := range authCmd.Commands() {
            if existing.Name() == sub.Name() || existing.HasAlias(sub.Name()) {
                return
            }
        }
        authCmd.AddCommand(sub)
    }

    addAuthSubcommand(&cobra.Command{
        Use:   "login",
        Short: "{{templateAuthLoginShort}}",
        Long:  `{{templateAuthLoginLong}}`,
        Annotations: map[string]string{
            "speakeasy_settings_command": "true",
            {{- if eq (helpStyle) "compact"}}
            "speakeasy_help_settings": "{{templateSettingsHelpFlags "login"}}",
            "speakeasy_help_see_also": "{{templateSettingsHelpSeeAlso "login"}}",
            {{- end}}
        },
        {{- if eq (helpStyle) "compact"}}
        Example: "{{templateSettingsHelpExample "auth login"}}",
        {{- end}}
        Args:  cobra.NoArgs,
        RunE:  runAuthLoginCmd,
    })

    addAuthSubcommand(&cobra.Command{
        Use:   "whoami",
        Short: "{{templateWhoamiShort}}",
        Long:  `Display the currently configured settings and their sources.

Sources are shown as:
  [flag]    - Set via command line flag
  [env]     - Set via environment variable ({{.Global.Config.EnvVarPrefix}}_*)
{{- if hasGlobalSecurity}}
  [keyring] - Set via OS credential store: macOS Keychain, Windows Credential Manager or Secret Service (stored by login/configure command)
{{- end}}
  [config]  - Set via config file (~/.config/{{sanitizeCliName}}/config.yaml)
  [unset]   - Not configured
{{- if hasGlobalSecurity}}

Credential values are masked for security.
{{- end}}`,
        Annotations: map[string]string{"speakeasy_settings_command": "true"},
        Args: cobra.NoArgs,
        RunE: runWhoamiCmd,
    })

    addAuthSubcommand(&cobra.Command{
        Use:   "logout",
        Short: "Clear all stored authentication credentials",
        Long:  `Clear all stored authentication credentials from both the OS keychain and config file.

This removes all credentials previously set via auth login or configure.`,
        Annotations: map[string]string{"speakeasy_settings_command": "true"},
        Args: cobra.NoArgs,
        RunE: runAuthLogoutCmd,
    })

    return nil
}

// runAuthLoginCmd executes the auth login command using guided forms.
func runAuthLoginCmd(cmd *cobra.Command, args []string) error {
    if dryRunLocalNoop(cmd, "auth login changes local credentials only (no API request); nothing was changed.") {
        return nil
    }
    cfg := config.GetConfig()
    if cfg == nil {
        cfg = &config.Config{}
    }
    {{- if hasSecretCLIFields}}

    keychainStored := false
    {{- end}}

    {{- if templateHasSecuritySchemeGroups}}
    formMode := interactive.Resolve(cmd).SetupFormMode(flagutil.AnyFlagChanged(cmd, {{templateAuthLoginFlagNames}}))

    {{templateAuthLoginBody | indent 4 | trim}}
    {{- else}}
    return flagutil.WithCLIValidation(fmt.Errorf("this API declares no global credentials; supply credentials on each command instead"))
    {{- end}}

    // #region custom-auth-store
    // #endregion custom-auth-store

    if err := config.SaveConfig(cfg); err != nil {
        return fmt.Errorf("failed to save configuration: %w", err)
    }

    if output.IsMachineMode(cmd) {
        return output.LocalResult(cmd, map[string]any{
            "config_file": config.GetConfigPath(),
            {{- if hasSecretCLIFields}}
            "keychain_stored": keychainStored,
            {{- end}}
        })
    }
    out := cmd.OutOrStdout()
    {{- if hasSecretCLIFields}}
    if keychainStored {
        fmt.Fprintln(out, "Secret credentials stored in OS keychain")
    }
    {{- end}}
    fmt.Fprintf(out, "Configuration saved to %s\n", config.GetConfigPath())
    return nil
}

// runAuthLogoutCmd clears all stored authentication credentials.
func runAuthLogoutCmd(cmd *cobra.Command, args []string) error {
    if dryRunLocalNoop(cmd, "auth logout removes local credentials only (no API request); nothing was changed.") {
        return nil
    }
    cfg := config.GetConfig()
    if cfg == nil {
        cfg = &config.Config{}
    }

    {{templateAuthLogoutClear | indent 4 | trim}}

    if err := config.SaveConfig(cfg); err != nil {
        return fmt.Errorf("failed to save configuration: %w", err)
    }

    if output.IsMachineMode(cmd) {
        return output.LocalResult(cmd, map[string]any{
            "config_file":      config.GetConfigPath(),
            "cleared":          true,
            "keychain_cleared": config.KeyringAvailable(),
        })
    }
    out := cmd.OutOrStdout()
    if !config.KeyringAvailable() {
        fmt.Fprintln(out, "Authentication credentials have been cleared from the config file; the OS keychain was skipped, so credentials stored there (if any) were kept.")
    } else {
        fmt.Fprintln(out, "All authentication credentials have been cleared.")
    }
    fmt.Fprintf(out, "Configuration saved to %s\n", config.GetConfigPath())
    return nil
}
